# Chaîne de connexion PostgreSQL Supabase — bouton "Connect" → onglet "Session pooler".
# Le Session pooler (port 5432) fonctionne en IPv4 sans add-on payant, contrairement à la
# connexion directe (db.xxxx.supabase.co) et au Transaction pooler, qui exigent IPv6.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:VOTRE_MOT_DE_PASSE@aws-x-region.pooler.supabase.com:5432/postgres

# Port d'écoute local (Render fournit automatiquement PORT en production)
PORT=4000
